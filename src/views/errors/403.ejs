<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Not allowed · <%= appName %></title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <div style="min-height:100vh;display:grid;place-items:center;padding:24px;">
    <div class="card" style="max-width:440px;padding:34px;text-align:center;">
      <div class="badge badge-red" style="margin-bottom:16px;">403 · Forbidden</div>
      <h1 style="margin-bottom:8px;">You don&rsquo;t have access</h1>
      <p class="muted">Your account role doesn&rsquo;t permit this action. If you believe this is a mistake, ask an administrator to review your access level.</p>
      <a class="btn btn-primary" href="/">Back to overview</a>
    </div>
  </div>
</body>
</html>
