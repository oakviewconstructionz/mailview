<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Not found · <%= appName %></title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
  <div style="min-height:100vh;display:grid;place-items:center;padding:24px;">
    <div class="card" style="max-width:440px;padding:34px;text-align:center;">
      <div class="badge" style="margin-bottom:16px;">404</div>
      <h1 style="margin-bottom:8px;">Page not found</h1>
      <p class="muted">The page you were looking for doesn&rsquo;t exist or has moved.</p>
      <a class="btn btn-primary" href="/">Back to overview</a>
    </div>
  </div>
</body>
</html>
