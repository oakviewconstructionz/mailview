<%
  // Shell header — sidebar + topbar, then opens the scrolling content area.
  // Usage: include this partial passing { title: 'Inbox', active: 'inbox' }.
  var nav = [
    { group: 'Workspace', items: [
      { key: 'overview', label: 'Overview', href: '/', ico: 'grid' },
      { key: 'inbox',    label: 'Inbox',    href: '/inbox', ico: 'mail', count: (locals.nav && nav.unreadMail) || 0 },
    ]},
    { group: 'Audience', items: [
      { key: 'contacts', label: 'Contacts', href: '/contacts', ico: 'users' },
      { key: 'lists',    label: 'Lists & segments', href: '/lists', ico: 'layers' },
    ]},
    { group: 'Marketing', items: [
      { key: 'campaigns', label: 'Campaigns', href: '/campaigns', ico: 'send' },
      { key: 'analytics', label: 'Analytics', href: '/analytics', ico: 'chart' },
    ]},
    { group: 'System', items: [
      { key: 'settings', label: 'Settings', href: '/settings', ico: 'settings' },
    ]},
  ];
  var currentUser = locals.currentUser;
-%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title ? title + ' · ' + appName : appName %></title>
  <meta name="theme-color" content="#0d1b2a">
  <link rel="stylesheet" href="/static/css/app.css?v=<%= assetVer %>">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%230d1b2a'/><text x='16' y='22' font-size='16' font-family='Arial' fill='white' text-anchor='middle'>O</text></svg>">
</head>
<body>
<div class="shell">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-mark">OV</div>
      <div class="brand-text">
        <b><%= appName %></b>
        <span>Business Mail</span>
      </div>
    </div>

    <nav class="nav">
      <% nav.forEach(function (group) { %>
        <div class="nav-group-label"><%= group.group %></div>
        <% group.items.forEach(function (item) { %>
          <a class="nav-item <%= active === item.key ? 'active' : '' %>" href="<%= item.href %>">
            <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <% if (item.ico === 'grid') { %><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><% } %>
              <% if (item.ico === 'mail') { %><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 6.5 8 6a2 2 0 0 0 2 0l8-6"/><% } %>
              <% if (item.ico === 'users') { %><path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20"/><circle cx="9.5" cy="7.5" r="3.5"/><path d="M21 20v-1.5a4 4 0 0 0-3-3.87"/><path d="M16.5 4.1a3.5 3.5 0 0 1 0 6.8"/><% } %>
              <% if (item.ico === 'layers') { %><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/><% } %>
              <% if (item.ico === 'send') { %><path d="M21.5 2.5 10.5 13.5"/><path d="M21.5 2.5 14.5 21l-4-7.5-7.5-4 18.5-7Z"/><% } %>
              <% if (item.ico === 'layout') { %><rect x="3" y="3" width="18" height="18" rx="2.5"/><path d="M3 9h18M9 21V9"/><% } %>
              <% if (item.ico === 'chart') { %><path d="M3 3v18h18"/><path d="M7 15l3.5-4 3 2.5L20 7"/><% } %>
              <% if (item.ico === 'settings') { %><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-2.87 1.2V21a2 2 0 1 1-4 0v-.1A1.7 1.7 0 0 0 7 19.4a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 3 15a1.7 1.7 0 0 0-1.55-1H1.3a2 2 0 1 1 0-4h.15A1.7 1.7 0 0 0 3 8.9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 7 4.6a1.7 1.7 0 0 0 1-1.55V2.9a2 2 0 1 1 4 0v.15A1.7 1.7 0 0 0 15 4.6a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9v.1a1.7 1.7 0 0 0 1.55 1h.15a2 2 0 1 1 0 4h-.15a1.7 1.7 0 0 0-1.55 1Z"/><% } %>
            </svg>
            <span><%= item.label %></span>
            <% if (item.count) { %><span class="count"><%= item.count %></span><% } %>
          </a>
        <% }); %>
      <% }); %>
    </nav>

    <div class="sidebar-foot">
      <% if (currentUser) { %>
        <div class="user-chip">
          <div class="avatar"><%= h.initials(currentUser.name) %></div>
          <div class="u-meta">
            <b><%= currentUser.name %></b>
            <span><%= currentUser.role %></span>
          </div>
        </div>
        <form method="post" action="/auth/logout" style="margin-top:12px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-block" style="background:transparent;border-color:rgba(255,255,255,.16);color:#c3cede;">
            Sign out
          </button>
        </form>
      <% } %>
    </div>
  </aside>

  <div class="main">
    <header class="topbar">
      <button class="menu-btn" id="menuBtn" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <div>
        <h1><%= title || appName %></h1>
      </div>
      <div class="topbar-spacer"></div>
      <div class="topbar-actions">
        <a class="btn btn-sm" href="/inbox?compose=1">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v16M4 12h16"/></svg>
          Compose
        </a>
      </div>
    </header>
    <div class="content">
      <%- include('flash') %>
