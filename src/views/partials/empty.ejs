<div class="empty">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="m3 8 9 5 9-5"/>
  </svg>
  <h3><%= typeof heading !== 'undefined' ? heading : 'Nothing here yet' %></h3>
  <p><%= typeof message !== 'undefined' ? message : '' %></p>
  <% if (typeof actionHref !== 'undefined' && actionHref) { %>
    <a class="btn btn-primary" href="<%= actionHref %>"><%= actionLabel || 'Get started' %></a>
  <% } %>
</div>
