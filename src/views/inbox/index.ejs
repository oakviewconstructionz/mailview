<%- include('../partials/shell-top', { title: 'Inbox', active: 'inbox' }) %>

<% if (error) { %>
  <div class="flash flash-error" style="margin-bottom:14px;"><%= error %></div>
<% } %>
<% if (!configured) { %>
  <div class="alert mb-3">
    <strong>Mailbox not connected.</strong>
    No mail can be read or sent until IMAP/SMTP credentials are added.
    <a href="/settings">Open Settings → Integrations</a>. Nothing is simulated.
  </div>
<% } %>

<div class="inbox <%= selected ? 'reading' : '' %>">

  <!-- Folders -->
  <aside class="inbox-folders">
    <div class="row between" style="padding:0 8px 12px;">
      <span class="small muted" style="font-weight:600;text-transform:uppercase;letter-spacing:.04em;">Folders</span>
      <a class="small" href="/inbox/settings">Status</a>
    </div>

    <% folders.forEach(function (f) { %>
      <% var isCurrent = (folder === f.path) || (f.key && typeof specialKey === 'function' && specialKey(folder) === f.key); %>
      <a class="folder-item <%= isCurrent ? 'active' : '' %>"
         href="/inbox?folder=<%= encodeURIComponent(f.path) %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;">
          <% if (f.key === 'inbox') { %><path d="M3 6.5 5 4h14l2 2.5"/><rect x="3" y="6.5" width="18" height="13" rx="2"/><path d="M3 12h5l1.5 2.5h5L16 12h5"/><% } else { %><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><% } %>
        </svg>
        <span><%= f.name %></span>
      </a>
    <% }); %>

    <div class="mt-3">
      <a class="btn btn-block btn-sm" href="/inbox/compose">Compose</a>
    </div>
  </aside>

  <!-- Message list -->
  <section class="inbox-list">
    <div style="padding:14px 16px;border-bottom:1px solid var(--line);">
      <form method="get" action="/inbox" class="row" style="gap:8px;">
        <input type="hidden" name="folder" value="<%= folder %>">
        <input class="input" type="search" name="q" value="<%= q %>" placeholder="Search this folder…" style="padding:7px 10px;font-size:13px;">
        <button class="btn btn-sm" type="submit">Search</button>
      </form>
      <div class="row between mt-1">
        <span class="small muted"><%= messages.length %> message<%= messages.length === 1 ? '' : 's' %></span>
        <form method="post" action="/inbox/sync">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="folder" value="<%= folder %>">
          <input type="hidden" name="q" value="<%= q %>">
          <button class="btn btn-sm" type="submit" <%= configured ? '' : 'disabled' %>>Sync</button>
        </form>
      </div>
    </div>

    <%- include('partials/message-list', { messages: messages, folder: folder, q: q, selected: selected }) %>
  </section>

  <!-- Reading pane -->
  <section class="inbox-read">
    <% if (selected) { %>
      <%- include('partials/reading-pane', { selected: selected, attachments: attachments, folder: folder, folders: folders, configured: configured, csrfToken: (typeof csrfToken !== 'undefined' ? csrfToken : '') }) %>
    <% } else { %>
      <%- include('../partials/empty', {
        heading: messages.length ? 'Select a message' : 'Nothing here yet',
        message: messages.length
          ? 'Choose a message on the left to read it.'
          : (configured ? 'This folder is empty. Try Sync to fetch the latest mail.' : 'Connect your mailbox in Settings to start receiving mail.')
      }) %>
    <% } %>
  </section>
</div>

<%- include('../partials/shell-bottom') %>
