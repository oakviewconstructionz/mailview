<%- include('../partials/shell-top', { title: 'Compose', active: 'inbox' }) %>

<div class="page-head">
  <div class="titles">
    <h1>Compose</h1>
    <p class="sub">Send a message from your connected mailbox.</p>
  </div>
  <div class="row">
    <a class="btn" href="/inbox">Back to inbox</a>
  </div>
</div>

<% if (!configured) { %>
  <div class="alert mb-3">
    <strong>Mailbox not connected.</strong>
    Sending is blocked until IMAP/SMTP credentials are added.
    <a href="/settings">Open Settings → Integrations</a>. Nothing will be simulated.
  </div>
<% } %>

<div id="composePanel" style="max-width:760px;">
  <% if (error) { %>
    <div class="flash flash-error" style="margin-bottom:14px;"><%= error %></div>
  <% } %>

  <% if (templates.length) { %>
  <div class="card mb-3">
    <div class="card-head"><h2>Start from a template</h2></div>
    <div class="card-body">
      <div class="row" style="gap:10px; align-items:flex-end;">
        <div class="field" style="flex:1; margin:0;">
          <label for="templatePicker">Template</label>
          <select class="select" id="templatePicker">
            <option value="">— Choose a template —</option>
            <% templates.forEach(function (t) { %>
              <option value="<%= t.id %>" <%= String(draft.templateId) === String(t.id) ? 'selected' : '' %>><%= t.name %></option>
            <% }); %>
          </select>
        </div>
        <a class="btn" id="templatePreview" href="#" target="_blank" rel="noopener" style="display:none;">Preview</a>
      </div>
      <div class="hint" id="templateNote">Choosing a template fills the subject and sends the branded HTML design.</div>
    </div>
  </div>
  <% } %>

  <div class="card mb-3">
    <div class="card-head"><h2>Add recipients in bulk</h2></div>
    <div class="card-body">
      <div class="row wrap" style="gap:8px; align-items:center;">
        <select class="select" id="listPicker" style="max-width:230px;">
          <option value="">All contacts</option>
          <% lists.forEach(function (l) { %>
            <option value="<%= l.id %>"><%= l.name %></option>
          <% }); %>
        </select>
        <input class="input" id="contactSearch" type="search" placeholder="Search name or email…" style="max-width:230px;padding:7px 10px;font-size:13px;">
        <select class="select" id="addTarget" style="max-width:130px;">
          <option value="to">Add to To</option>
          <option value="cc">Add to Cc</option>
          <option value="bcc">Add to Bcc</option>
        </select>
        <button class="btn btn-sm" type="button" id="addFiltered">Add all shown</button>
      </div>
      <div id="contactResults" class="mt-2"></div>
    </div>
  </div>

  <form id="composeForm" method="post" action="/inbox/compose" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="inReplyTo" value="<%= inReplyTo || '' %>">
    <input type="hidden" name="references" value="<%= references || '' %>">
    <input type="hidden" name="html" id="htmlBody" value="<%= draft.html || '' %>">
    <input type="hidden" name="templateId" id="templateId" value="<%= draft.templateId || '' %>">

    <div class="field">
      <label for="to">To</label>
      <input class="input" id="to" name="to" type="text" value="<%= draft.to %>" placeholder="name@example.com, another@example.com" required>
    </div>
    <div class="row" style="gap:12px;">
      <div class="field" style="flex:1;">
        <label for="cc">Cc</label>
        <input class="input" id="cc" name="cc" type="text" value="<%= draft.cc %>" placeholder="optional">
      </div>
      <div class="field" style="flex:1;">
        <label for="bcc">Bcc</label>
        <input class="input" id="bcc" name="bcc" type="text" value="<%= draft.bcc %>" placeholder="optional">
      </div>
    </div>
    <div class="field">
      <label for="subject">Subject</label>
      <input class="input" id="subject" name="subject" type="text" value="<%= draft.subject %>" required>
    </div>
    <div class="field">
      <label for="body">Message <span class="muted">(plain-text version)</span></label>
      <textarea class="textarea" id="body" name="body" rows="12" style="width:100%;font-family:inherit;"><%= draft.body %></textarea>
      <div class="hint">When a template is chosen, this holds its plain-text copy. The branded HTML is sent alongside it.</div>
    </div>
    <div class="field">
      <label for="attachments">Attachments</label>
      <input class="input" id="attachments" name="attachments" type="file" multiple>
      <div class="hint">Up to 8 files, 15 MB each.</div>
    </div>

    <div class="row" style="gap:10px;">
      <button class="btn btn-primary" type="submit">Send</button>
      <a class="btn" href="/inbox">Cancel</a>
    </div>
  </form>
</div>

<script>
(function () {
  function stripTags(html) {
    return String(html || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  }
  function escapeAttr(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function splitEmails(v) {
    return String(v || '').split(/[,;\n]/).map(function (s) { return s.trim(); }).filter(Boolean);
  }
  function addEmails(field, emails) {
    if (!field) return 0;
    var seen = splitEmails(field.value).map(function (e) { return e.toLowerCase(); });
    var added = 0;
    emails.forEach(function (e) {
      var v = String(e || '').trim();
      if (!v || seen.indexOf(v.toLowerCase()) !== -1) return;
      seen.push(v.toLowerCase());
      field.value = field.value.trim() ? field.value.replace(/[\s,;]+$/, '') + ', ' + v : v;
      added += 1;
    });
    return added;
  }

  function bindForm() {
    var form = document.getElementById('composeForm');
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    form.addEventListener('submit', function (e) {
      if (!window.fetch || !window.FormData) return; // let the browser submit (with _csrf field)
      var tokenInput = form.querySelector('input[name="_csrf"]');
      var res = tokenInput ? tokenInput.value : '';
      e.preventDefault();
      // A multipart body is not parsed by the app's CSRF middleware, so the token
      // is sent as a header. redirect:'manual' keeps the success flash intact for
      // the navigation that follows (so the "Message sent" notice is shown).
      fetch(form.getAttribute('action'), {
        method: 'POST',
        body: new FormData(form),
        headers: { 'X-CSRF-Token': res, 'Accept': 'text/html' },
        credentials: 'same-origin',
        redirect: 'manual'
      }).then(function (r) {
        if (r.type === 'opaqueredirect' || r.status === 0 || r.ok) { window.location = '/inbox'; return null; }
        return r.text().then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var fresh = doc.getElementById('composePanel');
          var cur = document.getElementById('composePanel');
          if (fresh && cur) { cur.innerHTML = fresh.innerHTML; bindShell(); }
          else { window.location.reload(); }
        });
      }).catch(function () { form.submit(); });
    });
  }

  function bindTemplate() {
    var picker = document.getElementById('templatePicker');
    if (!picker || picker.dataset.bound === '1') return;
    picker.dataset.bound = '1';

    var preview = document.getElementById('templatePreview');
    var subjectEl = document.getElementById('subject');
    var bodyEl = document.getElementById('body');
    var htmlEl = document.getElementById('htmlBody');
    var idEl = document.getElementById('templateId');
    var note = document.getElementById('templateNote');

    picker.addEventListener('change', function () {
      var id = picker.value;
      if (!id) {
        if (preview) preview.style.display = 'none';
        if (htmlEl) htmlEl.value = '';
        if (idEl) idEl.value = '';
        if (note) note.textContent = 'Choosing a template fills the subject and sends the branded HTML design.';
        return;
      }
      picker.disabled = true;
      fetch('/templates/' + encodeURIComponent(id) + '/data', { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
        .then(function (r) { if (!r.ok) throw new Error('Could not load that template.'); return r.json(); })
        .then(function (t) {
          if (subjectEl) subjectEl.value = t.subject || '';
          if (htmlEl) htmlEl.value = t.html || '';
          if (idEl) idEl.value = String(t.id);
          if (bodyEl) bodyEl.value = (t.text && t.text.trim()) ? t.text : stripTags(t.html);
          if (preview) { preview.href = '/templates/' + t.id + '/preview'; preview.style.display = ''; }
          if (note) note.innerHTML = 'Using <strong>' + escapeAttr(t.name) + '</strong> — the branded HTML will be sent. Tokens like <span class="mono">{{first_name}}</span> are filled from the recipient\u2019s contact record.';
        })
        .catch(function (err) {
          if (note) note.textContent = err.message || 'Could not load that template.';
        })
        .finally(function () { picker.disabled = false; });
    });
  }

  function bindRecipients() {
    var search = document.getElementById('contactSearch');
    if (!search || search.dataset.bound === '1') return;
    search.dataset.bound = '1';

    var listPicker = document.getElementById('listPicker');
    var results = document.getElementById('contactResults');
    var addAll = document.getElementById('addFiltered');
    var target = document.getElementById('addTarget');
    var timer = null;

    function load() {
      var q = search.value.trim();
      var listId = listPicker ? listPicker.value : '';
      var url = '/inbox/recipients?q=' + encodeURIComponent(q) + (listId ? '&list_id=' + encodeURIComponent(listId) : '');
      results.innerHTML = '<div class="small muted">Loading…</div>';
      fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
        .then(function (r) { if (!r.ok) throw new Error('lookup failed'); return r.json(); })
        .then(function (data) {
          var list = data.contacts || [];
          if (!list.length) { results.innerHTML = '<div class="small muted">No matching contacts.</div>'; return; }
          results.innerHTML = '';
          list.forEach(function (c) {
            var name = [c.first_name, c.last_name].filter(Boolean).join(' ');
            var row = document.createElement('div');
            row.className = 'contact-row';
            row.dataset.email = c.email;
            row.style.cssText = 'display:flex;align-items:center;gap:8px;padding:6px 4px;border-bottom:1px solid var(--line-soft);';

            var info = document.createElement('div');
            info.style.cssText = 'flex:1;min-width:0;';
            var label = document.createElement('div');
            label.className = 'small';
            label.style.cssText = 'overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
            label.textContent = name ? name + ' · ' + c.email : c.email;
            info.appendChild(label);
            if (c.company) {
              var co = document.createElement('div');
              co.className = 'small muted';
              co.textContent = c.company;
              info.appendChild(co);
            }

            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-sm';
            btn.textContent = 'Add';
            btn.addEventListener('click', function () {
              var field = document.getElementById(target.value);
              var n = addEmails(field, [c.email]);
              btn.textContent = n ? 'Added ✓' : 'Already added';
              btn.disabled = true;
            });

            row.appendChild(info);
            row.appendChild(btn);
            results.appendChild(row);
          });
        })
        .catch(function () { results.innerHTML = '<div class="small muted">Could not load contacts.</div>'; });
    }

    search.addEventListener('input', function () {
      clearTimeout(timer);
      timer = setTimeout(load, 250);
    });
    if (listPicker) listPicker.addEventListener('change', load);

    if (addAll) addAll.addEventListener('click', function () {
      var emails = [];
      results.querySelectorAll('.contact-row').forEach(function (row) {
        if (row.dataset.email) emails.push(row.dataset.email);
      });
      if (!emails.length) return;
      var field = document.getElementById(target.value);
      var n = addEmails(field, emails);
      addAll.textContent = n ? 'Added ' + n : 'All already added';
      setTimeout(function () { addAll.textContent = 'Add all shown'; }, 1800);
    });

    load();
  }

  function bindShell() {
    bindForm();
    bindTemplate();
    bindRecipients();
  }

  bindShell();
})();
</script>

<%- include('../partials/shell-bottom') %>
