<%- include('../partials/shell-top', { title: 'Compose', active: 'inbox' }) %>

<div class="page-head">
  <div class="titles">
    <h1>Compose</h1>
    <p class="sub">Send an email from your connected business mailbox.</p>
  </div>
  <div class="row">
    <a class="btn" href="/inbox">Back to inbox</a>
  </div>
</div>

<div class="card mb-3" style="background:#f8fafc;border-left:4px solid #16a34a;padding:10px 16px;">
  <span class="small" style="color:#0f172a;">
    Sending from: <strong>OakView Construction &lt;howard@oak-viewconstruction.com&gt;</strong> (Resend SMTP relay)
  </span>
</div>

<div id="composePanel" style="max-width:760px;">
  <div id="composeNotice" class="flash" style="display:none;margin-bottom:14px;"></div>
  <% if (error) { %>
    <div class="flash flash-error" style="margin-bottom:14px;"><%= error %></div>
  <% } %>

  <% if (templates && templates.length) { %>
  <div class="card mb-3">
    <div class="card-head"><h2>Start from a template</h2></div>
    <div class="card-body">
      <div class="row" style="gap:10px; align-items:flex-end;">
        <div class="field" style="flex:1; margin:0;">
          <label for="templatePicker">Template</label>
          <select class="select" id="templatePicker">
            <option value="">— Choose a template (optional) —</option>
            <% templates.forEach(function (t) { %>
              <option value="<%= t.id %>" <%= String(draft.templateId) === String(t.id) ? 'selected' : '' %>><%= t.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <form id="composeForm" method="post" action="/inbox/compose?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="inReplyTo" value="<%= inReplyTo || '' %>">
    <input type="hidden" name="references" value="<%= references || '' %>">
    <input type="hidden" name="html" id="htmlBody" value="<%= draft.html || '' %>">
    <input type="hidden" name="templateId" id="templateId" value="<%= draft.templateId || '' %>">

    <div class="field">
      <label for="to">To <span class="muted">(recipient email)</span></label>
      <input class="input" id="to" name="to" type="text" value="<%= draft.to %>" placeholder="recipient@example.com" required autocomplete="email">
    </div>

    <div class="row" style="gap:12px;">
      <div class="field" style="flex:1;">
        <label for="cc">Cc <span class="muted">(optional)</span></label>
        <input class="input" id="cc" name="cc" type="text" value="<%= draft.cc %>" placeholder="colleague@example.com">
      </div>
      <div class="field" style="flex:1;">
        <label for="bcc">Bcc <span class="muted">(optional)</span></label>
        <input class="input" id="bcc" name="bcc" type="text" value="<%= draft.bcc %>" placeholder="audit@example.com">
      </div>
    </div>

    <div class="field">
      <label for="subject">Subject</label>
      <input class="input" id="subject" name="subject" type="text" value="<%= draft.subject %>" placeholder="Email subject" required>
    </div>

    <div class="field">
      <label for="body">Message</label>
      <textarea class="textarea" id="body" name="body" rows="12" style="width:100%;font-family:inherit;line-height:1.6;" placeholder="Type your message here..." required><%= draft.body %></textarea>
    </div>

    <div class="field">
      <label for="attachments">Attachments</label>
      <input class="input" id="attachments" name="attachments" type="file" multiple>
      <div class="hint">Up to 8 files, 15 MB each. Saved automatically to your OakView site files.</div>
    </div>

    <div class="row" style="gap:10px; margin-top:20px;">
      <button class="btn btn-primary" id="sendBtn" type="submit" style="padding:10px 24px;font-weight:600;">Send Message</button>
      <a class="btn" href="/inbox">Cancel</a>
    </div>
  </form>
</div>

<script>
(function () {
  var form = document.getElementById('composeForm');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    ['to', 'cc', 'bcc'].forEach(function (id) {
      var input = document.getElementById(id);
      if (input && input.value) {
        input.value = input.value.replace(/@\.com\b/gi, '@gmail.com').replace(/@com\b/gi, '@gmail.com');
      }
    });
    var btn = document.getElementById('sendBtn');
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Sending message…';
    }
  });

  var picker = document.getElementById('templatePicker');
  if (picker) {
    picker.addEventListener('change', function () {
      var id = picker.value;
      if (!id) return;
      picker.disabled = true;
      fetch('/templates/' + encodeURIComponent(id) + '/data')
        .then(function (r) { if (!r.ok) throw new Error('Could not load template'); return r.json(); })
        .then(function (t) {
          if (t.subject) document.getElementById('subject').value = t.subject;
          if (t.html) document.getElementById('htmlBody').value = t.html;
          if (t.text || t.html) {
            document.getElementById('body').value = t.text || t.html.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
          }
          document.getElementById('templateId').value = String(t.id);
        })
        .catch(function () {})
        .finally(function () { picker.disabled = false; });
    });
  }
})();
</script>

<%- include('../partials/shell-bottom') %>
