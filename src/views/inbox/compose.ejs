<%- include('../partials/shell-top', { title: 'Compose', active: 'inbox' }) %>

<style>
  #visualEditor {
    min-height: 260px;
    max-height: 520px;
    overflow-y: auto;
    padding: 12px 14px;
    background: #ffffff;
    border: 1px solid var(--line, #cbd5e1);
    border-radius: 6px;
    font-family: inherit;
    font-size: 14px;
    line-height: 1.6;
    color: #1e293b;
    outline: none;
    white-space: pre-wrap;
    word-break: break-word;
  }
  #visualEditor:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }
  #visualEditor:empty::before {
    content: attr(data-placeholder);
    color: #94a3b8;
    pointer-events: none;
  }
  #visualEditor a {
    color: #2563eb !important;
    text-decoration: underline !important;
    font-weight: 500 !important;
    cursor: pointer;
  }
</style>

<div class="page-head">
  <div class="titles">
    <h1>Compose</h1>
    <p class="sub">Send an email from your connected business mailbox.</p>
  </div>
  <div class="row">
    <a class="btn" href="/inbox">Back to inbox</a>
  </div>
</div>

<div class="card mb-3" style="background:#f8fafc;border-left:4px solid #16a34a;padding:10px 16px;">
  <span class="small" style="color:#0f172a;">
    Sending from: <strong>OakView Construction &lt;howard@oak-viewconstruction.com&gt;</strong> (Resend SMTP relay)
  </span>
</div>

<div id="composePanel" style="max-width:760px;">
  <div id="composeNotice" class="flash" style="display:none;margin-bottom:14px;"></div>
  <% if (error) { %>
    <div class="flash flash-error" style="margin-bottom:14px;"><%= error %></div>
  <% } %>

  <form id="composeForm" method="post" action="/inbox/compose?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="inReplyTo" value="<%= inReplyTo || '' %>">
    <input type="hidden" name="references" value="<%= references || '' %>">
    <input type="hidden" name="html" id="htmlBody" value="<%= draft.html || '' %>">
    <textarea name="body" id="body" style="display:none;"><%= draft.body %></textarea>

    <div class="field">
      <label for="to">To <span class="muted">(recipient email, or leave blank to send to Bcc only)</span></label>
      <input class="input" id="to" name="to" type="text" value="<%= draft.to %>" placeholder="recipient@example.com (optional if using Bcc)" autocomplete="email">
    </div>

    <div class="row" style="gap:12px;">
      <div class="field" style="flex:1;">
        <label for="cc">Cc <span class="muted">(optional)</span></label>
        <input class="input" id="cc" name="cc" type="text" value="<%= draft.cc %>" placeholder="colleague@example.com">
      </div>
      <div class="field" style="flex:1;">
        <label for="bcc">Bcc <span class="muted">(optional)</span></label>
        <input class="input" id="bcc" name="bcc" type="text" value="<%= draft.bcc %>" placeholder="audit@example.com">
      </div>
    </div>

    <div class="field">
      <label for="subject">Subject</label>
      <input class="input" id="subject" name="subject" type="text" value="<%= draft.subject %>" placeholder="Email subject" required>
    </div>

    <div class="field">
      <div class="row between" style="align-items:center;margin-bottom:6px;">
        <label for="visualEditor" style="margin:0;font-weight:600;">Message</label>
        <div class="row" style="gap:8px;">
          <button type="button" class="btn btn-sm" id="openLinkModalBtn" style="padding:4px 11px;font-size:12px;display:inline-flex;align-items:center;gap:6px;background:#f0f9ff;border-color:#bae6fd;color:#0284c7;font-weight:600;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            Embed Link to Text
          </button>
        </div>
      </div>

      <!-- Visual Message Box: Shows real clickable blue hyperlinked text -->
      <div id="visualEditor" contenteditable="true" role="textbox" aria-multiline="true" data-placeholder="Type your message here..."></div>

      <div class="hint" style="margin-top:6px;font-size:12px;color:#64748b;">
        💡 Highlight any words and click <strong>Embed Link to Text</strong> (or press <strong>Ctrl+K</strong>) to insert clickable links directly into your text.
      </div>
    </div>

    <div class="field">
      <label for="attachments">Attachments</label>
      <input class="input" id="attachments" name="attachments" type="file" multiple>
      <div class="hint">Up to 8 files, 15 MB each. Saved automatically to your OakView site files.</div>
    </div>

    <div class="row" style="gap:10px; margin-top:20px;">
      <button class="btn btn-primary" id="sendBtn" type="submit" style="padding:10px 24px;font-weight:600;">Send Message</button>
      <a class="btn" href="/inbox">Cancel</a>
    </div>
  </form>
</div>

<!-- Modal Dialog for Embedding Link to Text -->
<div id="linkModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,0.5);z-index:9999;align-items:center;justify-content:center;backdrop-filter:blur(1px);">
  <div style="background:#ffffff;border-radius:12px;padding:22px 24px;width:92%;max-width:440px;box-shadow:0 20px 25px -5px rgba(0,0,0,0.2),0 10px 10px -5px rgba(0,0,0,0.08);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
      <h3 style="margin:0;font-size:16px;font-weight:700;color:#0f172a;display:flex;align-items:center;gap:8px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        Embed Link to Text
      </h3>
      <button type="button" id="closeLinkModalX" style="background:none;border:none;font-size:20px;cursor:pointer;color:#94a3b8;line-height:1;padding:2px 6px;">&times;</button>
    </div>

    <div class="field" style="margin-bottom:12px;">
      <label for="linkText" style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;color:#334155;">Text to display</label>
      <input type="text" id="linkText" class="input" placeholder="e.g. View Quote, Click here, Website" style="width:100%;">
    </div>

    <div class="field" style="margin-bottom:20px;">
      <label for="linkUrl" style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;color:#334155;">Link Web Address (URL)</label>
      <input type="text" id="linkUrl" class="input" placeholder="https://example.com/quote" style="width:100%;">
    </div>

    <div style="display:flex;justify-content:flex-end;gap:10px;">
      <button type="button" class="btn btn-sm" id="cancelLinkBtn">Cancel</button>
      <button type="button" class="btn btn-sm btn-primary" id="applyLinkBtn" style="padding:7px 18px;font-weight:600;">Insert Link</button>
    </div>
  </div>
</div>

<script>
(function () {
  var form = document.getElementById('composeForm');
  var visualEditor = document.getElementById('visualEditor');
  var bodyInput = document.getElementById('body');
  var htmlInput = document.getElementById('htmlBody');
  var openLinkBtn = document.getElementById('openLinkModalBtn');
  var linkModal = document.getElementById('linkModal');
  var linkText = document.getElementById('linkText');
  var linkUrl = document.getElementById('linkUrl');
  var applyLinkBtn = document.getElementById('applyLinkBtn');
  var cancelLinkBtn = document.getElementById('cancelLinkBtn');
  var closeLinkModalX = document.getElementById('closeLinkModalX');

  if (!form || !visualEditor) return;

  // Initialize visual editor content
  var initialRaw = <%- JSON.stringify(draft.body || '') %>;
  var initialHtml = <%- JSON.stringify(draft.html || '') %>;

  if (initialHtml && initialHtml.trim()) {
    visualEditor.innerHTML = initialHtml;
  } else if (initialRaw) {
    // If draft.body contains markdown [text](url), convert to real <a> elements
    var formatted = initialRaw
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\[([^\]]+)\]\(((?:https?:\/\/|mailto:)[^\s)]+)\)/gi, function (_, label, url) {
        return '<a href="' + url + '" target="_blank" rel="noopener noreferrer" style="color:#2563eb;text-decoration:underline;font-weight:500;">' + label + '</a>';
      })
      .replace(/\r?\n/g, '<br>');
    visualEditor.innerHTML = formatted;
  }

  var savedRange = null;

  function saveCurrentSelection() {
    var sel = window.getSelection();
    if (sel && sel.rangeCount > 0) {
      var r = sel.getRangeAt(0);
      // Ensure selection is inside visualEditor
      if (visualEditor.contains(r.commonAncestorContainer)) {
        savedRange = r.cloneRange();
        return;
      }
    }
    savedRange = null;
  }

  function restoreSavedSelection() {
    if (savedRange) {
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(savedRange);
    }
  }

  function openLinkModal() {
    saveCurrentSelection();
    var selected = savedRange ? savedRange.toString().trim() : '';
    linkText.value = selected || '';
    linkUrl.value = '';
    linkModal.style.display = 'flex';
    if (selected) {
      linkUrl.focus();
    } else {
      linkText.focus();
    }
  }

  function closeLinkModal() {
    linkModal.style.display = 'none';
    visualEditor.focus();
  }

  if (openLinkBtn) openLinkBtn.addEventListener('click', openLinkModal);
  if (cancelLinkBtn) cancelLinkBtn.addEventListener('click', closeLinkModal);
  if (closeLinkModalX) closeLinkModalX.addEventListener('click', closeLinkModal);

  // Close modal when clicking outside modal box
  linkModal.addEventListener('click', function (e) {
    if (e.target === linkModal) closeLinkModal();
  });

  // Ctrl+K / Cmd+K inside editor
  visualEditor.addEventListener('keydown', function (e) {
    if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      openLinkModal();
    }
  });

  // Enter key inside URL field
  linkUrl.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      applyLink();
    }
  });

  function applyLink() {
    var text = (linkText.value || '').trim();
    var url = (linkUrl.value || '').trim();
    if (!url) {
      alert('Please enter a web address / link URL.');
      linkUrl.focus();
      return;
    }
    // Auto-prepend https:// if missing protocol
    if (!/^https?:\/\//i.test(url) && !/^mailto:/i.test(url)) {
      url = 'https://' + url;
    }
    if (!text) {
      text = url;
    }

    restoreSavedSelection();

    var a = document.createElement('a');
    a.href = url;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.style.color = '#2563eb';
    a.style.textDecoration = 'underline';
    a.style.fontWeight = '500';
    a.textContent = text;

    if (savedRange) {
      savedRange.deleteContents();
      savedRange.insertNode(a);

      // Add a trailing space so user can easily continue typing after the link
      var space = document.createTextNode('\u00A0');
      if (a.nextSibling) {
        a.parentNode.insertBefore(space, a.nextSibling);
      } else {
        a.parentNode.appendChild(space);
      }

      var sel = window.getSelection();
      sel.removeAllRanges();
      var newRange = document.createRange();
      newRange.setStartAfter(space);
      newRange.setEndAfter(space);
      sel.addRange(newRange);
    } else {
      visualEditor.appendChild(a);
      visualEditor.appendChild(document.createTextNode('\u00A0'));
    }

    closeLinkModal();
  }

  if (applyLinkBtn) applyLinkBtn.addEventListener('click', applyLink);

  form.addEventListener('submit', function (e) {
    ['to', 'cc', 'bcc'].forEach(function (id) {
      var input = document.getElementById(id);
      if (input && input.value) {
        input.value = input.value.replace(/@\.com\b/gi, '@gmail.com').replace(/@com\b/gi, '@gmail.com');
      }
    });

    var toVal = (document.getElementById('to').value || '').trim();
    var ccVal = (document.getElementById('cc').value || '').trim();
    var bccVal = (document.getElementById('bcc').value || '').trim();
    if (!toVal && !ccVal && !bccVal) {
      e.preventDefault();
      alert('Please add at least one recipient email address (in To, Cc, or Bcc).');
      return;
    }

    var editorText = (visualEditor.innerText || '').trim();
    var editorHtml = visualEditor.innerHTML || '';
    if (!editorText && !editorHtml) {
      e.preventDefault();
      alert('Please type a message before sending.');
      visualEditor.focus();
      return;
    }

    // Sync content to inputs
    bodyInput.value = visualEditor.innerText;
    htmlInput.value = '<!DOCTYPE html><html><body style="font-family:-apple-system,BlinkMacSystemFont,\'Segoe UI\',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#1e293b;">' + editorHtml + '</body></html>';

    var btn = document.getElementById('sendBtn');
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Sending message…';
    }
  });
})();
</script>

<%- include('../partials/shell-bottom') %>