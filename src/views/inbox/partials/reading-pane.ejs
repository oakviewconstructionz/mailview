<%
  var moveFolders = (typeof folders !== 'undefined' && folders && folders.length) ? folders : null;
  var toFirst = {};
  try { toFirst = JSON.parse(selected.to_json || '[]')[0] || {}; } catch (e) { toFirst = {}; }
  var toLabel = toFirst.email || toFirst.name || 'you';
  if (!toFirst.email && !toFirst.name) { toLabel = 'you'; }
%>
<div class="read-head">
  <div class="row between">
    <h2><%= selected.subject || '(no subject)' %></h2>
    <% if (selected.is_starred) { %>
      <svg viewBox="0 0 24 24" fill="currentColor" style="width:16px;height:16px;color:#e0a72b;flex:0 0 16px;"><path d="m12 17.3-6.2 3.7 1.6-7-5.4-4.7 7.1-.6L12 2l2.9 6.7 7.1.6-5.4 4.7 1.6 7z"/></svg>
    <% } %>
  </div>
  <div class="small muted">
    <div><strong style="color:var(--ink);"><%= selected.from_name || selected.from_email || '(unknown sender)' %></strong>
      <% if (selected.from_email && selected.from_name) { %>&lt;<%= selected.from_email %>&gt;<% } %></div>
    <div class="mt-1">to <%= toLabel %></div>
    <div class="mt-1"><%= h.formatDateTime(selected.received_at || selected.sent_at || selected.synced_at) %></div>
  </div>
</div>

<div class="read-actions">
  <a class="btn btn-sm" href="/inbox/compose?replyToId=<%= selected.id %>">Reply</a>
  <a class="btn btn-sm" href="/inbox/compose?forwardId=<%= selected.id %>">Forward</a>

  <form method="post" action="/inbox/<%= selected.id %>/read">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="seen" value="<%= selected.is_read ? '0' : '1' %>">
    <button class="btn btn-sm" type="submit"><%= selected.is_read ? 'Mark unread' : 'Mark read' %></button>
  </form>

  <form method="post" action="/inbox/<%= selected.id %>/flag">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="starred" value="<%= selected.is_starred ? '0' : '1' %>">
    <button class="btn btn-sm" type="submit"><%= selected.is_starred ? 'Unstar' : 'Star' %></button>
  </form>

  <% if (moveFolders) { %>
    <form method="post" action="/inbox/<%= selected.id %>/move" class="row" style="gap:6px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <select class="select" name="folder" style="width:auto;padding:5px 8px;font-size:12px;">
        <% moveFolders.forEach(function (f) { %>
          <% if (f.path !== (selected.folder || folder)) { %>
            <option value="<%= f.path %>"><%= f.name %></option>
          <% } %>
        <% }); %>
      </select>
      <button class="btn btn-sm" type="submit">Move</button>
    </form>
  <% } %>

  <% if (configured) { %>
    <form method="post" action="/inbox/<%= selected.id %>/delete" data-confirm="Delete this message from the mailbox?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm btn-danger" type="submit">Delete</button>
    </form>
  <% } %>
</div>

<div class="read-body">
  <% if (selected.html_body) { %>
    <iframe sandbox="" srcdoc="<%= selected.html_body %>" title="Message body"></iframe>
  <% } else if (selected.text_body) { %>
    <pre style="white-space:pre-wrap;word-wrap:break-word;margin:0;font-family:inherit;"><%= selected.text_body %></pre>
  <% } else { %>
    <p class="muted">This message has no body content cached. Try Sync to fetch it.</p>
  <% } %>

  <% if (attachments && attachments.length) { %>
    <div class="mt-3">
      <div class="small muted" style="margin-bottom:8px;">Attachments</div>
      <div class="stack" style="display:flex;flex-wrap:wrap;gap:10px;">
        <% attachments.forEach(function (a) { %>
          <a class="attachment" href="/inbox/attachment/<%= a.id %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21.4 11.05 12.25 20.2a6 6 0 0 1-8.49-8.49l9.2-9.2a4 4 0 0 1 5.65 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
            <span><%= a.filename || 'attachment' %></span>
            <span class="faint"><%= a.size_bytes ? h.formatNumber(a.size_bytes) + ' B' : '' %></span>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>
