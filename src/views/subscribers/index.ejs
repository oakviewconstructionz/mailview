<%- include('../partials/shell-top', { title: 'Contacts', active: 'contacts' }) %>
<%
  var statusBadge = function (st) {
    if (st === 'subscribed') return 'badge-green';
    if (st === 'bounced' || st === 'complained') return 'badge-red';
    if (st === 'pending') return 'badge-blue';
    return 'badge-amber';
  };
  var pageUrl = function (p) {
    var parts = [];
    if (q) parts.push('q=' + encodeURIComponent(q));
    if (status) parts.push('status=' + encodeURIComponent(status));
    if (listId) parts.push('list_id=' + listId);
    if (typeof perPage !== 'undefined' && perPage !== 25) parts.push('per_page=' + perPage);
    parts.push('page=' + p);
    return '/contacts?' + parts.join('&');
  };
%>

<div class="page-head">
  <div class="titles">
    <h1>Contacts</h1>
    <p class="sub">Your audience — subscribers, list membership and status at a glance.</p>
  </div>
  <div class="row">
    <a class="btn" href="/contacts/export<%= exportQuery ? '?' + exportQuery : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12m0 0 4-4m-4 4-4-4"/><path d="M4 18v2h16v-2"/></svg>
      Export CSV
    </a>
    <a class="btn" href="/contacts/import">Import</a>
    <a class="btn btn-primary" href="/contacts/new">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      Add subscriber
    </a>
  </div>
</div>

<div class="grid grid-4 mb-3">
  <div class="card stat">
    <div class="label">Total contacts</div>
    <div class="value mono"><%= h.formatNumber(counts.total || 0) %></div>
    <div class="delta"><%= h.formatNumber(pg.total) %> in current view</div>
  </div>
  <div class="card stat">
    <div class="label">Subscribed</div>
    <div class="value mono"><%= h.formatNumber(counts.subscribed || 0) %></div>
    <div class="delta up">ready to receive</div>
  </div>
  <div class="card stat">
    <div class="label">Unsubscribed</div>
    <div class="value mono"><%= h.formatNumber(counts.unsubscribed || 0) %></div>
    <div class="delta">opted out</div>
  </div>
  <div class="card stat">
    <div class="label">Suppressed</div>
    <div class="value mono"><%= h.formatNumber(suppressed) %></div>
    <div class="delta"><a href="/lists/suppressions">Manage suppression list</a></div>
  </div>
</div>

<form class="toolbar mb-3" method="get" action="/contacts">
  <div class="search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input class="input" type="search" name="q" value="<%= q %>" placeholder="Search email, name or company">
  </div>
  <select class="select" name="status" style="width:auto;">
    <option value="">All statuses</option>
    <% statuses.forEach(function (s) { %>
      <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
    <% }); %>
  </select>
  <select class="select" name="list_id" style="width:auto;">
    <option value="">All lists</option>
    <% lists.forEach(function (l) { %>
      <option value="<%= l.id %>" <%= listId === l.id ? 'selected' : '' %>><%= l.name %></option>
    <% }); %>
  </select>
  <select class="select" name="per_page" style="width:auto;" onchange="this.form.submit()">
    <option value="25" <%= (typeof perPage !== 'undefined' && perPage === 25) ? 'selected' : '' %>>25 per page</option>
    <option value="50" <%= (typeof perPage !== 'undefined' && perPage === 50) ? 'selected' : '' %>>50 per page</option>
    <option value="100" <%= (typeof perPage !== 'undefined' && perPage === 100) ? 'selected' : '' %>>100 per page</option>
    <option value="250" <%= (typeof perPage !== 'undefined' && perPage === 250) ? 'selected' : '' %>>250 per page</option>
    <option value="500" <%= (typeof perPage !== 'undefined' && perPage === 500) ? 'selected' : '' %>>500 per page</option>
  </select>
  <button class="btn" type="submit">Filter</button>
  <% if (q || status || listId) { %><a class="btn btn-ghost" href="/contacts">Clear</a><% } %>
</form>

<% if (!rows.length) { %>
  <div class="card">
    <%- include('../partials/empty', {
      heading: 'No contacts found',
      message: 'Adjust your filters, or add your first subscriber to get started.',
      actionHref: '/contacts/new',
      actionLabel: 'Add subscriber'
    }) %>
  </div>
<% } else { %>
  <form id="bulkContactsForm" method="post" action="/contacts/bulk">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="all_matching" id="allMatchingInput" value="0">
    <input type="hidden" name="q" value="<%= q %>">
    <input type="hidden" name="status" value="<%= status %>">
    <input type="hidden" name="list_id" value="<%= listId %>">

    <div class="card">
      <div class="card-head">
        <h2>Contacts</h2>
        <div class="spacer"></div>
        <span class="badge"><%= h.formatNumber(pg.total) %> matching</span>
      </div>

      <div id="selectionBanner" style="display:none;padding:10px 16px;background:var(--accent-subtle,#e8f0fe);border-bottom:1px solid var(--line);font-size:13px;text-align:center;">
        <span id="selectionText">All <%= rows.length %> contacts on this page are selected.</span>
        <% if (pg.total > rows.length) { %>
          <button type="button" class="btn btn-sm btn-ghost" id="selectAllMatchingBtn" style="margin-left:8px;font-weight:600;text-decoration:underline;cursor:pointer;">
            Select all <%= h.formatNumber(pg.total) %> contacts matching this view
          </button>
          <button type="button" class="btn btn-sm btn-ghost" id="clearSelectionBtn" style="margin-left:8px;display:none;cursor:pointer;">
            Clear selection
          </button>
        <% } %>
      </div>

      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th style="width:34px;">
                <input type="checkbox" id="masterCheckbox" title="Select all on this page">
              </th>
              <th>Subscriber</th>
              <th>Status</th>
              <th class="num">Lists</th>
              <th>Source</th>
              <th>Added</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function (s) { %>
            <tr>
              <td><input type="checkbox" name="ids" value="<%= s.id %>" class="row-checkbox"></td>
              <td>
                <a class="row-link" href="/contacts/<%= s.id %>"><%= s.email %></a>
                <div class="small muted truncate" style="max-width:320px;">
                  <%= [s.first_name, s.last_name].filter(Boolean).join(' ') || '—' %><%= s.company ? ' · ' + s.company : '' %>
                </div>
              </td>
              <td>
                <span class="badge <%= statusBadge(s.status) %>"><span class="badge-dot"></span><%= s.status %></span>
              </td>
              <td class="num"><%= h.formatNumber(s.list_count) %></td>
              <td class="small muted"><%= s.source %></td>
              <td class="small muted nowrap"><%= h.formatDate(s.created_at) %></td>
              <td class="text-right"><a class="small" href="/contacts/<%= s.id %>">Open</a></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="card-foot row between">
        <div class="row" style="gap:8px;">
          <select class="select" name="action" id="bulkActionSelect" style="width:auto;">
            <option value="">Bulk action…</option>
            <option value="delete">Delete selected</option>
            <% if (pg.total > 0) { %>
              <option value="delete_all">Delete all <%= h.formatNumber(pg.total) %> contacts matching this view</option>
            <% } %>
            <option value="suppress">Suppress selected</option>
            <% if (pg.total > 0) { %>
              <option value="suppress_all">Suppress all <%= h.formatNumber(pg.total) %> contacts matching this view</option>
            <% } %>
          </select>
          <button class="btn btn-sm" type="submit" id="applyBulkBtn">Apply</button>
        </div>
        <span class="small muted" id="selectedCountMsg">Tick rows above, or choose an "all matching" action.</span>
      </div>
    </div>
  </form>

  <script>
  (function () {
    var master = document.getElementById('masterCheckbox');
    var rowChecks = document.querySelectorAll('.row-checkbox');
    var banner = document.getElementById('selectionBanner');
    var selectionText = document.getElementById('selectionText');
    var selectAllMatchingBtn = document.getElementById('selectAllMatchingBtn');
    var clearSelectionBtn = document.getElementById('clearSelectionBtn');
    var allMatchingInput = document.getElementById('allMatchingInput');
    var actionSelect = document.getElementById('bulkActionSelect');
    var form = document.getElementById('bulkContactsForm');
    var selectedCountMsg = document.getElementById('selectedCountMsg');
    var totalMatching = <%= pg.total %>;

    function updateCount() {
      if (allMatchingInput.value === '1') {
        if (selectedCountMsg) selectedCountMsg.textContent = 'All ' + totalMatching.toLocaleString() + ' matching contacts selected.';
        return;
      }
      var checked = document.querySelectorAll('.row-checkbox:checked').length;
      if (selectedCountMsg) {
        selectedCountMsg.textContent = checked ? (checked + ' contact' + (checked === 1 ? '' : 's') + ' selected on this page.') : 'Tick rows above, or choose an "all matching" action.';
      }
    }

    if (master) {
      master.addEventListener('change', function () {
        var isChecked = master.checked;
        allMatchingInput.value = '0';
        rowChecks.forEach(function (c) { c.checked = isChecked; });
        if (isChecked && banner) {
          banner.style.display = '';
          selectionText.textContent = 'All ' + rowChecks.length + ' contacts on this page are selected.';
          if (selectAllMatchingBtn) selectAllMatchingBtn.style.display = '';
          if (clearSelectionBtn) clearSelectionBtn.style.display = 'none';
        } else if (banner) {
          banner.style.display = 'none';
        }
        updateCount();
      });
    }

    rowChecks.forEach(function (c) {
      c.addEventListener('change', function () {
        allMatchingInput.value = '0';
        if (banner) banner.style.display = 'none';
        if (master) {
          master.checked = (document.querySelectorAll('.row-checkbox:checked').length === rowChecks.length);
        }
        updateCount();
      });
    });

    if (selectAllMatchingBtn) {
      selectAllMatchingBtn.addEventListener('click', function () {
        allMatchingInput.value = '1';
        selectionText.textContent = 'All ' + totalMatching.toLocaleString() + ' contacts matching this view are selected.';
        selectAllMatchingBtn.style.display = 'none';
        if (clearSelectionBtn) clearSelectionBtn.style.display = '';
        updateCount();
      });
    }

    if (clearSelectionBtn) {
      clearSelectionBtn.addEventListener('click', function () {
        allMatchingInput.value = '0';
        if (master) master.checked = false;
        rowChecks.forEach(function (c) { c.checked = false; });
        if (banner) banner.style.display = 'none';
        updateCount();
      });
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        var action = actionSelect ? actionSelect.value : '';
        if (!action) {
          e.preventDefault();
          alert('Please choose a bulk action first.');
          return;
        }

        var isAll = (allMatchingInput.value === '1' || action === 'delete_all' || action === 'suppress_all');
        var checkedCount = document.querySelectorAll('.row-checkbox:checked').length;

        if (!isAll && !checkedCount) {
          e.preventDefault();
          alert('Please select at least one contact checkbox, or choose an "all matching" action.');
          return;
        }

        var msg = '';
        if (action === 'delete_all' || (action === 'delete' && isAll)) {
          msg = 'Are you sure you want to PERMANENTLY DELETE ALL ' + totalMatching.toLocaleString() + ' matching contact(s)? This action cannot be undone.';
        } else if (action === 'delete') {
          msg = 'Are you sure you want to delete the ' + checkedCount + ' selected contact(s)?';
        } else if (action === 'suppress_all' || (action === 'suppress' && isAll)) {
          msg = 'Suppress all ' + totalMatching.toLocaleString() + ' matching contact(s)? They will never receive campaign emails.';
        } else if (action === 'suppress') {
          msg = 'Suppress the ' + checkedCount + ' selected contact(s)?';
        }

        if (msg && !confirm(msg)) {
          e.preventDefault();
        }
      });
    }
  })();
  </script>

  <% if (pg.totalPages > 1) { %>
    <div class="row between mt-3">
      <span class="small muted">Page <%= pg.page %> of <%= pg.totalPages %></span>
      <div class="row" style="gap:8px;">
        <% if (pg.hasPrev) { %><a class="btn btn-sm" href="<%= pageUrl(pg.page - 1) %>">Previous</a><% } %>
        <% if (pg.hasNext) { %><a class="btn btn-sm" href="<%= pageUrl(pg.page + 1) %>">Next</a><% } %>
      </div>
    </div>
  <% } %>
<% } %>

<%- include('../partials/shell-bottom') %>
