# ============================================================================
# OakView Mail — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Anything left blank here can also be entered later in the app's
# Settings → Integrations screen (stored encrypted in the database).
# ============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public URL the app is served from (used for tracking pixels/links & resets)
APP_URL=https://oak-viewconstruction.com
APP_NAME=OakView Mail

# 32+ character random secret. Encrypts stored integration secrets (AES-256-GCM)
# and signs sessions. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEY=change-me-to-a-long-random-secret-string-min-32-chars
SESSION_SECRET=change-me-to-another-long-random-secret-string

# --- Database (MySQL) --------------------------------------------------------
# Railway/other hosts usually inject these automatically when you add a MySQL
# plugin. If your host gives you a single connection URL, set DATABASE_URL
# instead and the individual values below are ignored.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=oakview_mail
DB_SSL=false

# --- Initial admin (used only by `npm run seed`) -----------------------------
ADMIN_EMAIL=admin@oak-viewconstruction.com
ADMIN_NAME=OakView Admin
ADMIN_PASSWORD=ChangeThisOnFirstLogin!

# ============================================================================
# EMAIL DELIVERY (marketing / bulk campaigns)  — pluggable provider
# ============================================================================
# Which delivery provider to use: sender | smtp
DELIVERY_PROVIDER=sender

# --- Sender.net (primary delivery provider) ---------------------------------
SENDER_API_TOKEN=

# --- Generic SMTP delivery fallback (e.g. Resend/Brevo/Amazon SES SMTP) -------
SMTP_DELIVERY_HOST=
SMTP_DELIVERY_PORT=587
SMTP_DELIVERY_USER=
SMTP_DELIVERY_PASS=
SMTP_DELIVERY_SECURE=false
SMTP_DELIVERY_FROM=OakView Construction <hello@oak-viewconstruction.com>
# Cap messages per minute when sending through the SMTP provider
SMTP_DELIVERY_RATE=60

# ============================================================================
# MAILBOX (inbox / read / reply / forward / compose) — separate from delivery
# ============================================================================
# Which mailbox provider to use: imap (Gmail / Google Workspace or any IMAP box)
MAILBOX_PROVIDER=imap

# --- IMAP (incoming) ---------------------------------------------------------
# For Gmail: imap.gmail.com / smtp.gmail.com, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# --- SMTP (outgoing for the mailbox) ----------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Name/address shown on messages you send from the inbox
MAILBOX_FROM_NAME=OakView Construction
MAILBOX_FROM_EMAIL=

# --- Cloudflare Email Routing -------------------------------------------------
# Informational only. Cloudflare Email Routing is FORWARD-ONLY infrastructure
# (it forwards mail to Gmail); it is NOT an IMAP mailbox and is never queried
# as one. It is shown in Settings purely to document the forwarding setup.
CLOUDFLARE_ROUTING_NOTE=Cloudflare Email Routing forwards incoming mail to the connected mailbox. Forwarding only — not an IMAP mailbox.

# --- Sending limits / scaling ------------------------------------------------
# Max recipients processed per minute (respects your provider's plan limits).
CAMPAIGN_RATE_PER_MINUTE=300
# How many messages to send concurrently
CAMPAIGN_CONCURRENCY=5
# Batch size and the pause between batches (background queue throttling)
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_BATCH_INTERVAL=10
# Hard cap on recipients per single campaign (blocked if exceeded)
CAMPAIGN_MAX_RECIPIENTS=3000
# Your provider plan's monthly email allowance (0 = unlimited/unknown).
# Used by the pre-flight check so we never exceed your real quota.
DELIVERY_MONTHLY_LIMIT=0
# Run the in-process campaign worker inside the web process (true on Railway).
# Set false to run a dedicated worker via `npm run worker`.
RUN_WORKER_IN_WEB=true
